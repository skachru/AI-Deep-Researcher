# ── Required ──────────────────────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ── History, analytics and sign-in (optional but recommended) ─────────────
# Postgres connection string. On Vercel: Storage → Create → Neon (free) sets this for you.
DATABASE_URL=
# Random secret (32+ chars) used to sign login sessions. Generate: openssl rand -base64 48
AUTH_SECRET=
# Google sign-in (https://console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, "Web application").
# Authorised redirect URI: https://<your-domain>/api/auth/google/callback (and http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the public URL used for the Google redirect, e.g. https://lumen-researcher.vercel.app
APP_URL=
# Comma-separated admin emails (can open /admin)
ADMIN_EMAILS=skachru@gmail.com

# ── Email (needed for "email me this report"; also enables email-link sign-in) ──
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char app password from https://myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional display name/address, e.g. "Lumen Research <you@gmail.com>"
EMAIL_FROM=

# ── Optional ──────────────────────────────────────────────────────────────
# LUMEN_MODEL=claude-opus-5-5
# Max research runs per visitor per hour (admins are exempt)
RUNS_PER_HOUR=10
# Replay recorded runs for the example queries instead of calling the API
NEXT_PUBLIC_DEMO_MODE=false
